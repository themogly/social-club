includes:
    - vendor/larastan/larastan/extension.neon
parameters:
    level: 6
    paths:
        - app
    # add more paths (config, database, routes) once level 6 is green on app/
    # This codebase declares casts via the Laravel 11 casts() METHOD; tell Larastan
    # to read it so custom casts (MoneyCast->Money, WeightCast->Weight, enum casts)
    # are understood instead of falling back to the raw column type.
    parseModelCastsMethod: true
