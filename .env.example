APP_NAME="CSC platform"
APP_ENV=local
APP_KEY=
# Safe-by-default: never leak stack traces in production. Flip to true for local dev only.
APP_DEBUG=false
APP_URL=http://localhost

# Ships multilingual: Spanish default, English second. Spanish is also the fallback.
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------------
# Local dev: SQLite. PRODUCTION IS MYSQL (see the block below) — a transactional
# app must not run SQLite in prod, and tests also run on MySQL in CI (phpunit.mysql.xml).
DB_CONNECTION=sqlite
# Production (MySQL):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=csc_platform
# DB_USERNAME=csc_platform
# DB_PASSWORD=

# --- Sessions / cache / queue -------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# TRUE in production (HTTPS). MUST be false or unset for local http:// dev, or the
# session cookie is never sent and login silently fails (see SETUP.md).
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Redis-backed queue (Horizon) and cache. Never cache transactional data.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis (pure-PHP) — the phpredis C extension is not required.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (Resend in production; log driver locally) --------------------------
# Local dev uses the `log` mailer and the /dev/mail preview. Production sets
# MAIL_MAILER=resend and requires the resend/resend-laravel package (see SETUP.md).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_KEY=

# --- Object storage -----------------------------------------------------------
# General uploads (may be public). ID documents & member photos use a SEPARATE
# private, encrypted disk — never this one (see config/filesystems.php: `documents`).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# ID documents / member photos disk. `local` for dev; set `s3` in production with
# a dedicated private bucket below.
DOCUMENTS_DRIVER=local
AWS_DOCUMENTS_BUCKET=

# --- Error monitoring ---------------------------------------------------------
SENTRY_LARAVEL_DSN=
# Sample rate for performance tracing (0.0–1.0).
SENTRY_TRACES_SAMPLE_RATE=0.2

VITE_APP_NAME="${APP_NAME}"
